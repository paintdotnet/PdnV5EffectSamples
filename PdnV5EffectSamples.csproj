<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>PaintDotNet.Effects.Samples</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <Deterministic>False</Deterministic>
    
    <!-- Specifying * for the 3rd field will cause the compiler to auto-generate the build (3rd field)
         and revision (4th field) based on the current date and time. This removes the need for you to
         manually update the version every time you release a new build. For some reason the compiler 
         will also warn about this with CS7035, so that is suppressed. -->
    <AssemblyVersion>5.2.*</AssemblyVersion>
    <NoWarn>CS7035</NoWarn>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PaintDotNet.Plugin.Sdk" Version="*-*" />
    <PackageReference Include="AutoConstructor" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ComputeSharp.D2D1" Version="3.2.0" />
    <PackageReference Include="ILRepack" Version="2.0.48">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="11.0.*-*" />
  </ItemGroup>
  
  <!-- This <Target> node is optional. The DLLs used are trimmed and then merged into a single DLL. If 
       you don't do this then you'll need to distribute your plugin DLLs and .deps.json file in a ZIP 
       file that must be unpacked into its own folder. If everything is in one DLL then you don't need 
       the folder or the deps.json file.-->
  <Target Name="TrimAndMerge" AfterTargets="PostBuildEvent" Condition="'$(ConfigurationName)' == 'Release'">
    <!-- Nuget documentation for $(PkgPackage_Name) properties: https://learn.microsoft.com/en-us/nuget/consume-packages/package-references-in-project-files -->

    <!-- Find the folder that NuGet resolved the Paint.NET reference assemblies from. This follows the
         package's TFM folder (e.g. ref\net11.0-windows7.0) without hard-coding it, so it keeps working
         when TargetFramework or the package version changes. -->
    <ItemGroup>
      <_PdnPluginSdkReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'PaintDotNet.Plugin.Sdk'" />
    </ItemGroup>
    <PropertyGroup>
      <_PdnPluginSdkRefDir>%(_PdnPluginSdkReference.RootDir)%(_PdnPluginSdkReference.Directory)</_PdnPluginSdkRefDir>
      <_PdnPluginSdkRefDir>$(_PdnPluginSdkRefDir.TrimEnd('\'))</_PdnPluginSdkRefDir>
    </PropertyGroup>
    <Error Condition="'$(_PdnPluginSdkRefDir)' == ''" Text="Could not find the PaintDotNet.Plugin.Sdk reference assemblies among the resolved references." />

    <!-- Trimming with ILLink -->

    <!-- Find illink.dll inside the Microsoft.NET.ILLink.Tasks package. The name of the folder can change 
         between versions (tools\net8.0, tools\net9.0, tools\net, ...), so it is located with a wildcard
         instead of being hard-coded. -->
    <ItemGroup>
      <_ILLinkDll Include="$(PkgMicrosoft_NET_ILLink_Tasks)\tools\*\illink.dll" />
    </ItemGroup>
    <PropertyGroup>
      <_ILLinkDllPath>@(_ILLinkDll)</_ILLinkDllPath>
    </PropertyGroup>
    <Error Condition="'$(_ILLinkDllPath)' == '' Or $(_ILLinkDllPath.Contains(';'))" Text="Expected exactly one illink.dll under '$(PkgMicrosoft_NET_ILLink_Tasks)\tools', found: '$(_ILLinkDllPath)'" />

    <!-- ILLink must be able to resolve everything the trimmed assemblies reference, including the framework.
         It removes any custom attribute whose type it cannot resolve, and that includes layout-affecting
         ones such as [InlineArray], which silently corrupts struct sizes. -->
    <ItemGroup>
      <_ILLinkRefDir Include="$([System.IO.Path]::GetDirectoryName('%(ReferencePath.FullPath)'))" />
    </ItemGroup>
    <PropertyGroup>
      <_ILLinkRefDirArgs>@(_ILLinkRefDir-&gt;Distinct()-&gt;'-d "%(Identity)"', ' ')</_ILLinkRefDirArgs>
    </PropertyGroup>

    <!-- Referenced assemblies are only resolved, never written out ('skip'); the plugin itself is copied
         through untouched, and only the two ComputeSharp assemblies are trimmed. -->
    <Exec Command="dotnet exec &quot;$(_ILLinkDllPath)&quot; -a &quot;$(TargetName)&quot; all --trim-mode skip --action skip --action copy &quot;$(TargetName)&quot; --action link &quot;ComputeSharp.Core&quot; --action link &quot;ComputeSharp.D2D1&quot; -d &quot;$(TargetDir.TrimEnd('\'))&quot; $(_ILLinkRefDirArgs) --skip-unresolved -out &quot;$(TargetDir)output&quot;" />

    <!-- Merge with ILRepack so we have only 1 DLL --> 
    
    <!-- The /lib directories let ILRepack resolve the Paint.NET reference assemblies and the 
         ComputeSharp assemblies while it reads the inputs. -->
    <Exec Command="&quot;$(PkgILRepack)\tools\ilrepack&quot; /internalize /union &quot;$(TargetDir)output\$(TargetName).dll&quot; &quot;$(TargetDir)output\ComputeSharp.Core.dll&quot; &quot;$(TargetDir)output\ComputeSharp.D2D1.dll&quot; /lib:&quot;$(_PdnPluginSdkRefDir)&quot; /lib:&quot;$(TargetDir)output&quot; /out:&quot;$(TargetPath)&quot;" />
    
    <!-- Remove the output directory and its contents created by illink -->
    <Delete Files="$(TargetDir)output" ContinueOnError="false" />
    <RemoveDir Directories="$(TargetDir)output" ContinueOnError="false" />
    
    <!-- Remove ComputeSharp DLLs that are now merged -->
    <Delete Files="$(TargetDir)ComputeSharp.Core.dll" ContinueOnError="false" />
    <Delete Files="$(TargetDir)ComputeSharp.D2D1.dll" ContinueOnError="false" />

    <!-- And because we have a single DLL now, we can remove the .deps.json -->
    <Delete Files="$(TargetDir)PdnV5EffectSamples.deps.json" ContinueOnError="false" />
  </Target>
</Project>

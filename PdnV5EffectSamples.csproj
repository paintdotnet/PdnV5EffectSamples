<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>PaintDotNet.Effects.Samples</RootNamespace>
    <Nullable>enable</Nullable>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>    
    <!-- This is necessary so that the build copies the version of nuget packages we're referencing,
         instead of copying the ones that Paint.NET is using (which may be trimmed and/or a different version) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <Deterministic>False</Deterministic>
    <AssemblyVersion>5.2.*</AssemblyVersion>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>1701;1702;CS7035</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PaintDotNet.Plugins.Sdk" Version="*-*" />
    <PackageReference Include="AutoConstructor" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ComputeSharp.D2D1" Version="3.2.0" />
    <PackageReference Include="ILRepack" Version="2.0.48">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="9.0.0" />
  </ItemGroup>
  <Target Name="TrimAndMerge" AfterTargets="PostBuildEvent" Condition="'$(ConfigurationName)' == 'Release'">
    <!-- Nuget documentation for $(PkgPackage_Name) properties: https://learn.microsoft.com/en-us/nuget/consume-packages/package-references-in-project-files -->

    <!-- Find the folder that NuGet resolved the Paint.NET reference assemblies from. This follows the
         package's TFM folder (e.g. ref\net11.0-windows7.0) without hard-coding it, so it keeps working
         when TargetFramework or the package version changes. -->
    <ItemGroup>
      <_PdnPluginsSdkReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'PaintDotNet.Plugins.Sdk'" />
    </ItemGroup>
    <PropertyGroup>
      <_PdnPluginsSdkRefDir>%(_PdnPluginsSdkReference.RootDir)%(_PdnPluginsSdkReference.Directory)</_PdnPluginsSdkRefDir>
      <_PdnPluginsSdkRefDir>$(_PdnPluginsSdkRefDir.TrimEnd('\'))</_PdnPluginsSdkRefDir>
    </PropertyGroup>
    <Error Condition="'$(_PdnPluginsSdkRefDir)' == ''" Text="Could not find the PaintDotNet.Plugins.Sdk reference assemblies among the resolved references." />

    <!-- Trimming with ILLink -->

    <!-- Find illink.dll inside the Microsoft.NET.ILLink.Tasks package. Each version of the package has
         exactly one, but the name of the folder it sits in changes between versions (tools\net8.0,
         tools\net9.0, tools\net, ...), so it is located with a wildcard instead of being hard-coded. -->
    <ItemGroup>
      <_ILLinkDll Include="$(PkgMicrosoft_NET_ILLink_Tasks)\tools\*\illink.dll" />
    </ItemGroup>
    <PropertyGroup>
      <_ILLinkDllPath>@(_ILLinkDll)</_ILLinkDllPath>
    </PropertyGroup>
    <Error Condition="'$(_ILLinkDllPath)' == '' Or $(_ILLinkDllPath.Contains(';'))" Text="Expected exactly one illink.dll under '$(PkgMicrosoft_NET_ILLink_Tasks)\tools', found: '$(_ILLinkDllPath)'" />

    <Exec Command="dotnet exec &quot;$(_ILLinkDllPath)&quot; -a &quot;$(TargetPath)&quot; all --trim-mode copy --action copy -d $(TargetDir) --skip-unresolved --action link &quot;ComputeSharp.Core&quot; --action link &quot;ComputeSharp.D2D1&quot; -out &quot;$(TargetDir)output&quot;" />

    <!-- Merge with ILRepack so we have only 1 DLL --> 
    
    <!-- The /lib directories let ILRepack resolve the Paint.NET reference assemblies and the 
         ComputeSharp assemblies while it reads the inputs. -->
    <Exec Command="&quot;$(PkgILRepack)\tools\ilrepack&quot; /internalize /union &quot;$(TargetDir)output\$(TargetName).dll&quot; &quot;$(TargetDir)output\ComputeSharp.Core.dll&quot; &quot;$(TargetDir)output\ComputeSharp.D2D1.dll&quot; /lib:&quot;$(_PdnPluginsSdkRefDir)&quot; /lib:&quot;$(TargetDir)output&quot; /out:&quot;$(TargetPath)&quot;" />
    
    <!-- Remove the output directory and its contents created by illink -->
    <Delete Files="$(TargetDir)output" ContinueOnError="false" />
    <RemoveDir Directories="$(TargetDir)output" ContinueOnError="false" />
    
    <!-- Remove ComputeSharp DLLs that are now merged -->
    <Delete Files="$(TargetDir)ComputeSharp.Core.dll" ContinueOnError="false" />
    <Delete Files="$(TargetDir)ComputeSharp.D2D1.dll" ContinueOnError="false" />

    <!-- And because we have a single DLL now, we can remove the .deps.json -->
    <Delete Files="$(TargetDir)PdnV5EffectSamples.deps.json" ContinueOnError="false" />
  </Target>
</Project>

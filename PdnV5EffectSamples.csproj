<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>PaintDotNet.Effects.Samples</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <!-- Set up AssemblyFileVersion so the Build and Revision fields are auto-generated based on the
         local time. This removes the need for you to manually update the version every time you
         release a new update for your plugin. The FileVersion element doesn't accept wildcards, so
         it is the more static "product" version. -->
    <FileVersion>5.2</FileVersion>
    <AssemblyVersion>$(FileVersion).*</AssemblyVersion>
    <!-- Deterministic build is not allowed when using a wildcard version. -->
    <Deterministic>False</Deterministic>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Use *-* for the plugin SDK reference so that the latest version is always used. This makes sure 
         you always have the latest APIs available, and that deprecated APIs are not accidentally used. -->
    <PackageReference Include="Paint.NET.Plugin.SDK" Version="*-*" />    
    <PackageReference Include="ComputeSharp.D2D1" Version="3.2.0" />
    <PackageReference Include="AutoConstructor" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Trimming and Merging -->
  <!-- This step is optional. The plugin DLL and its dependencies are trimmed and then merged into a single 
       DLL. If you don't do this then you'll need to distribute your plugin DLLs and .deps.json file in a 
       ZIP file that must be unpacked into its own folder. If everything is in one DLL then you don't need 
       the folder or the deps.json file.-->

  <!-- Packages used for trimming and merging -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="11.0.*-*" />
    <PackageReference Include="ILRepack" Version="2.0.48">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
  <!-- Trimming opt-out List -->
  <!-- Every DLL that your NuGet packages bring in (including their own dependencies) is found automatically,
       trimmed, and merged into your plugin's DLL. Trimming removes unused code, but it can break libraries
       that rely on reflection. List those here by assembly name to merge them without trimming. -->
  <ItemGroup>
    <!-- <PluginNoTrim Include="Newtonsoft.Json" /> -->
  </ItemGroup>
  
  <Target Name="TrimAndMerge" AfterTargets="PostBuildEvent" Condition="'$(ConfigurationName)' == 'Release'">
    <!-- Nuget documentation for $(PkgPackage_Name) properties: https://learn.microsoft.com/en-us/nuget/consume-packages/package-references-in-project-files -->

    <!-- Trimming with ILLink -->

    <!-- Find illink.dll inside the Microsoft.NET.ILLink.Tasks package. The name of the folder can change 
         between versions (tools\net8.0, tools\net9.0, tools\net, ...), so it is located with a wildcard
         instead of being hard-coded. -->
    <ItemGroup>
      <_ILLinkDll Include="$(PkgMicrosoft_NET_ILLink_Tasks)\tools\*\illink.dll" />
    </ItemGroup>
    <PropertyGroup>
      <_ILLinkDllPath>@(_ILLinkDll)</_ILLinkDllPath>
    </PropertyGroup>
    <Error Condition="'$(_ILLinkDllPath)' == '' Or $(_ILLinkDllPath.Contains(';'))" Text="Expected exactly one illink.dll under '$(PkgMicrosoft_NET_ILLink_Tasks)\tools', found: '$(_ILLinkDllPath)'" />

    <!-- ILLink must be able to resolve everything the trimmed assemblies reference, including .NET's DLLs.
         Otherwise it'll remove any custom attributes it can't resolve, like [InlineArray], which will
         break things with horrible crashes at runtime. -->
    <ItemGroup>
      <_ILLinkRefDir Include="$([System.IO.Path]::GetDirectoryName('%(ReferencePath.FullPath)'))" />
    </ItemGroup>
    <PropertyGroup>
      <_ILLinkRefDirArgs>@(_ILLinkRefDir-&gt;Distinct()-&gt;'-d "%(Identity)"', ' ')</_ILLinkRefDirArgs>
    </PropertyGroup>

    <!-- The assemblies to merge are the runtime DLLs from your NuGet packages, including transitive
         dependencies. Native DLLs and localized resource DLLs can't be merged, so they're excluded. Each
         one is trimmed ('link') unless it's listed in @(PluginNoTrim), in which case it is copied as-is. -->
    <ItemGroup>
      <_MergeAssemblyName Include="@(RuntimeCopyLocalItems-&gt;'%(Filename)')" Condition="'%(RuntimeCopyLocalItems.AssetType)' == 'runtime'" />
      <_TrimAssemblyName Include="@(_MergeAssemblyName)" Exclude="@(PluginNoTrim)" />
      <_NoTrimAssemblyName Include="@(_MergeAssemblyName)" Exclude="@(_TrimAssemblyName)" />
    </ItemGroup>
    <PropertyGroup>
      <_ILLinkActionArgs>@(_TrimAssemblyName-&gt;'--action link "%(Identity)"', ' ') @(_NoTrimAssemblyName-&gt;'--action copy "%(Identity)"', ' ')</_ILLinkActionArgs>
      <_ILRepackInputArgs>@(_MergeAssemblyName-&gt;'"$(TargetDir)output\%(Identity).dll"', ' ')</_ILRepackInputArgs>
    </PropertyGroup>

    <!-- Everything else is only resolved, never written out ('skip'). The plugin itself is not trimmed. -->
    <Exec Command="dotnet exec &quot;$(_ILLinkDllPath)&quot; -a &quot;$(TargetName)&quot; all --trim-mode skip --action skip --action copy &quot;$(TargetName)&quot; $(_ILLinkActionArgs) -d &quot;$(TargetDir.TrimEnd('\'))&quot; $(_ILLinkRefDirArgs) --skip-unresolved -out &quot;$(TargetDir)output&quot;" />

    <!-- Merge with ILRepack so we have only 1 DLL --> 
    
    <!-- The /lib directories let ILRepack resolve the Paint.NET reference assemblies and the merged
         assemblies while it reads the inputs. $(PdnPluginSdkRefDir) is defined by the
         Paint.NET.Plugin.SDK package. -->
    <Exec Command="&quot;$(PkgILRepack)\tools\ilrepack&quot; /internalize /union &quot;$(TargetDir)output\$(TargetName).dll&quot; $(_ILRepackInputArgs) /lib:&quot;$(PdnPluginSdkRefDir)&quot; /lib:&quot;$(TargetDir)output&quot; /out:&quot;$(TargetPath)&quot;" />
    
    <!-- Remove the output directory and its contents created by illink -->
    <Delete Files="$(TargetDir)output" ContinueOnError="false" />
    <RemoveDir Directories="$(TargetDir)output" ContinueOnError="false" />
    
    <!-- And because we have a single DLL now, we can remove the .deps.json -->
    <Delete Files="$(TargetDir)$(AssemblyName).deps.json" ContinueOnError="false" />
  </Target>
</Project>
